{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyTimeOff",
  "version": "0.1.0",
  "identifier": "com.mytimeoff.desktop",
  "build": {
    "frontendDist": "../../apps/reader/dist",
    "beforeDevCommand": "pnpm --filter @mytimeoff/reader build",
    "beforeBuildCommand": "pnpm --filter @mytimeoff/reader build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
